# 运行环境：development / test / production
AGENTHUB_ENV=development

# HTTP 服务端口
AGENTHUB_HTTP_PORT=8080

# 数据库连接串
AGENTHUB_DATABASE_URL=postgres:///agenthub?sslmode=disable

# 连接池配置
AGENTHUB_DB_POOL_MAX_CONNS=10
AGENTHUB_DB_POOL_MIN_CONNS=2
AGENTHUB_DB_POOL_MAX_CONN_LIFETIME=30m
AGENTHUB_DB_POOL_MAX_CONN_IDLE_TIME=5m
AGENTHUB_DB_POOL_HEALTH_CHECK_PERIOD=30s

# 会话配置
AGENTHUB_SESSION_TTL=30m
AGENTHUB_SESSION_CLEANUP_INTERVAL=5m
AGENTHUB_SESSION_MAX_HISTORY=20

# 模型配置（必填）
AGENTHUB_MODEL_API_KEY=your-api-key
AGENTHUB_MODEL_BASE_URL=https://your-provider.example/v1
AGENTHUB_MODEL_NAME=your-tool-calling-model
